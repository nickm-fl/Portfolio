---
interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Nick Montelibano, independent medical device software consultant at Fractal Logic. 10+ years architecting safety-critical software: embedded firmware, connected systems, IEC 62304 compliance, and FDA submissions. Based in Minneapolis, Minnesota.";
const ogImage = new URL("/webp/Profile_Photo_Square.webp", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#070c10" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Nick Montelibano, Nicholas Montelibano, Fractal Logic, Medical Device Software Consultant, IEC 62304, FDA submission, Embedded Systems Consultant, Software Architecture, Medical Device Software Minnesota, Independent Software Consultant Minneapolis"
    />

    <!-- Open Graph / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={Astro.url} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <link rel="preload" as="image" href="/webp/Profile_Photo_Square.webp" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Nick Montelibano",
        "alternateName": "Nicholas Montelibano",
        "jobTitle": "Medical Device Software Consultant",
        "description": "Independent software consultant specializing in medical device software architecture, embedded systems, and regulatory compliance (IEC 62304, FDA submissions).",
        "email": "mailto:nick@fractallogic.io",
        "url": "https://nickm.software",
        "sameAs": ["https://www.linkedin.com/in/nick-montelibano/"],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Minneapolis",
          "addressRegion": "MN",
          "addressCountry": "US"
        },
        "knowsAbout": [
          "Medical Device Software",
          "IEC 62304",
          "FDA Submissions",
          "Embedded Systems",
          "Software Architecture",
          "Systems Engineering"
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "Fractal Logic"
        }
      }
    </script>
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#home" class="skip-link">Skip to content</a>
    <div class="site-bg" aria-hidden="true"></div>
    <slot />

    <!-- Scroll-reveal: adds .is-visible when [data-reveal] elements enter the viewport -->
    <script>
      document.documentElement.classList.add("js");

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const targets = document.querySelectorAll("[data-reveal]");
      if (prefersReduced || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #070c10;
    --surface: #0d141b;
    --card: rgba(255, 255, 255, 0.03);
    --card-hover: rgba(255, 255, 255, 0.055);
    --line: rgba(148, 163, 184, 0.14);
    --line-strong: rgba(148, 163, 184, 0.28);
    --accent: #2dd4bf;
    --accent-2: #38bdf8;
    --accent-dim: rgba(45, 212, 191, 0.12);
    --text: #e8eef4;
    --muted: #93a4b8;
    --font-body: "Inter", system-ui, -apple-system, sans-serif;
    --font-display: "Space Grotesk", "Inter", system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 88px;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  ::selection {
    background-color: var(--accent);
    color: #06251f;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 12px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg);
  }
  ::-webkit-scrollbar-thumb {
    background: #1e2a36;
    border-radius: 8px;
    border: 3px solid var(--bg);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #2b3b4b;
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: #1e2a36 var(--bg);
  }

  /* Accessibility */
  .skip-link {
    position: fixed;
    top: -100px;
    left: 16px;
    z-index: 200;
    padding: 10px 18px;
    background: var(--accent);
    color: #06251f;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 16px;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ---- Ambient background: engineering grid + drifting glows ---- */
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 80% 50% at 50% -10%,
        rgba(45, 212, 191, 0.08),
        transparent 60%
      ),
      var(--bg);
  }

  .site-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(
      ellipse 90% 70% at 50% 0%,
      black 30%,
      transparent 85%
    );
    mask-image: radial-gradient(
      ellipse 90% 70% at 50% 0%,
      black 30%,
      transparent 85%
    );
  }

  .site-bg::after {
    content: "";
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(
        circle 640px at 22% 28%,
        rgba(45, 212, 191, 0.07),
        transparent 70%
      ),
      radial-gradient(
        circle 720px at 78% 72%,
        rgba(56, 189, 248, 0.06),
        transparent 70%
      );
    animation: bg-drift 48s ease-in-out infinite alternate;
  }

  @keyframes bg-drift {
    from {
      transform: translate3d(-2%, -2%, 0) scale(1);
    }
    to {
      transform: translate3d(2%, 3%, 0) scale(1.06);
    }
  }

  /* ---- Shared building blocks ---- */
  .container-site {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .eyebrow::before {
    content: "";
    width: 1.75rem;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .glass {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 1rem;
    backdrop-filter: blur(8px);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .glass:hover {
    background: var(--card-hover);
    border-color: var(--line-strong);
  }

  .text-gradient {
    background: linear-gradient(100deg, var(--accent) 10%, var(--accent-2) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #06251f;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
    box-shadow: 0 0 0 0 rgba(45, 212, 191, 0);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 8px 30px -8px rgba(45, 212, 191, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: 0.75rem;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }
  .btn-secondary:hover {
    border-color: var(--line-strong);
    background: var(--card-hover);
    transform: translateY(-2px);
  }

  /* ---- Scroll reveal ---- */
  html.js [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  html.js [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    html.js [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .site-bg::after {
      animation: none;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
