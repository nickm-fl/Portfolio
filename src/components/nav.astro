---
import BrandLockup from "./BrandLockup.astro";

const links = [
  { label: "Expertise", href: "#expertise" },
  { label: "Process", href: "#process" },
  { label: "Platforms", href: "#platforms" },
];

// Mobile bottom tab bar
const mobileLinks = [
  {
    label: "Home",
    href: "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>`,
  },
  {
    label: "Expertise",
    href: "#expertise",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  },
  {
    label: "Platforms",
    href: "#platforms",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/></svg>`,
  },
  {
    label: "Contact",
    href: "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>`,
  },
];
---

<!-- Desktop top bar -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-[100] hidden md:block transition-all duration-300">
  <div class="container-site">
    <nav class="flex items-center justify-between py-3" aria-label="Primary">
      <a href="#home" class="brand">
        <span class="brand-name">Nick Montelibano</span>
        <BrandLockup size={20} />
      </a>

      <div class="flex items-center gap-2">
        <ul class="flex items-center gap-1 mr-2">
          {links.map((link) => (
            <li>
              <a href={link.href} class="nav-link">{link.label}</a>
            </li>
          ))}
        </ul>
        <a
          href="/Nick-Montelibano-Resume.pdf"
          download
          class="btn-secondary !py-2.5 !px-4 text-sm"
          aria-label="Download résumé as a PDF"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
          Résumé
        </a>
        <a href="#contact" class="btn-primary !py-2.5 !px-5 text-sm">Let's talk</a>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile bottom tab bar -->
<nav
  class="md:hidden fixed bottom-0 left-0 right-0 z-[100] mobile-bar"
  aria-label="Primary mobile"
>
  <ul class="flex justify-around items-stretch">
    {mobileLinks.map((item) => (
      <li class="flex-1">
        <a href={item.href} class="mobile-link flex flex-col items-center gap-1 py-2.5 text-[0.68rem]">
          <fragment set:html={item.icon} />
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Solidify the header once the page is scrolled
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Highlight the nav item for the section in view
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a[href^='#'], header a[href^='#']");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              link.classList.toggle(
                "active",
                link.getAttribute("href") === `#${id}`
              );
            });
          }
        });
      },
      { threshold: 0.4 }
    );
    sections.forEach((section) => observer.observe(section));
  });
</script>

<style>
  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    /* Clear space is 0.5 x mark (8.5px at size 20). Nothing may enter it. */
    gap: 0.625rem;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }
  .brand:hover {
    opacity: 0.82;
  }

  .brand-name {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  #site-header {
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  #site-header.scrolled {
    background: rgba(7, 12, 16, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border-radius: 0.6rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.25s ease, background-color 0.25s ease;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--card);
  }
  .nav-link.active {
    color: var(--accent);
  }

  .mobile-bar {
    background: rgba(7, 12, 16, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .mobile-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .mobile-link.active,
  .mobile-link:hover {
    color: var(--accent);
  }
</style>
