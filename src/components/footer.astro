---
import BrandLockup from "./BrandLockup.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] mt-4">
  <div class="container-site py-10 pb-28 md:pb-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col items-center md:items-start gap-2.5">
        <BrandLockup size={20} />
        <p class="text-xs text-[var(--muted)]">
          Nick Montelibano · Medical device software consulting · Minneapolis, MN
        </p>
      </div>

      <ul class="flex items-center gap-5 text-sm">
        <li>
          <a href="https://www.linkedin.com/in/nick-montelibano/" target="_blank" rel="noopener" class="footer-link">LinkedIn</a>
        </li>
        <li>
          <a href="mailto:nick@fractallogic.io" class="footer-link">Email</a>
        </li>
        <li>
          <a href="/Nick-Montelibano-Resume.pdf" download class="footer-link">Résumé</a>
        </li>
        <li>
          <a href="https://github.com/nickm-fl/Portfolio" target="_blank" rel="noopener" class="footer-link">Source</a>
        </li>
      </ul>
    </div>

    <div class="mt-8 pt-6 border-t border-[var(--line)] flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-[var(--muted)]">
        © {year} Nick Montelibano. All rights reserved.
      </p>
      <p class="text-xs text-[var(--muted)]">
        Built with Astro · Deployed on Vercel · Zero client-side frameworks
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .footer-link:hover {
    color: var(--accent);
  }
</style>
