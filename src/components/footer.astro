---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] mt-4">
  <div class="container-site py-10 pb-28 md:pb-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <span class="footer-mark" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12h4l2-7 4 14 2-7h8" />
          </svg>
        </span>
        <div class="leading-tight">
          <p class="text-sm font-medium text-[var(--text)]">Nick Montelibano · Fractal Logic</p>
          <p class="text-xs text-[var(--muted)]">Medical device software consulting · Minneapolis, MN</p>
        </div>
      </div>

      <ul class="flex items-center gap-5 text-sm">
        <li>
          <a href="https://www.linkedin.com/in/nick-montelibano/" target="_blank" rel="noopener" class="footer-link">LinkedIn</a>
        </li>
        <li>
          <a href="mailto:nick@fractallogic.io" class="footer-link">Email</a>
        </li>
        <li>
          <a href="/Nick-Montelibano-Resume.pdf" download class="footer-link">Résumé</a>
        </li>
        <li>
          <a href="https://github.com/nickm-fl/Portfolio" target="_blank" rel="noopener" class="footer-link">Source</a>
        </li>
      </ul>
    </div>

    <div class="mt-8 pt-6 border-t border-[var(--line)] flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-[var(--muted)]">
        © {year} Nick Montelibano. All rights reserved.
      </p>
      <p class="text-xs text-[var(--muted)]">
        Built with Astro · Deployed on Vercel · Zero client-side frameworks
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(45, 212, 191, 0.22);
  }

  .footer-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .footer-link:hover {
    color: var(--accent);
  }
</style>
