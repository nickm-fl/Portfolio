---
import LogoWall from "./logoWall.astro";

const credentials = [
  "IEC 62304",
  "FDA submissions",
  "First-in-human → market",
  "FMEA & risk-based design",
];

const stats = [
  { value: "10+", label: "Years in safety-critical medical device software" },
  {
    value: "6",
    label: "FDA device programs delivered — 5 IDE-approved, 1 510(k)-cleared",
  },
  { value: "1,000s", label: "Devices shipped and running in the field" },
  {
    value: "Technical lead",
    label: "Aligning cross-functional teams, vendors & stakeholders",
  },
];
---

<section id="home" class="pt-28 md:pt-40 pb-10">
  <div class="container-site">
    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center">
      <!-- Intro -->
      <div class="space-y-7" data-reveal>
        <p class="eyebrow">Independent Software Consultant · Minneapolis, MN</p>

        <h1 class="text-4xl md:text-6xl font-semibold leading-[1.08] text-balance">
          Medical device software, from
          <span class="text-gradient">bare metal</span> to
          <span class="text-gradient">FDA submission</span>.
        </h1>

        <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl leading-relaxed">
          I'm Nick Montelibano, founder of Fractal Logic. For over a decade I've
          architected and shipped safety-critical software for medical devices —
          embedded firmware, connected systems, and the compliance documentation
          that gets them through submission.
        </p>

        <div class="flex flex-wrap gap-3 pt-1">
          <a href="#contact" class="btn-primary">
            Start a conversation
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a
            href="/Nick-Montelibano-Resume.pdf"
            download
            class="btn-secondary"
            aria-label="Download Nick Montelibano's résumé as a PDF"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            Download résumé
          </a>
          <a href="#process" class="btn-secondary">See how I work</a>
        </div>

        <ul class="flex flex-wrap gap-2 pt-1" aria-label="Credentials">
          {credentials.map((item) => (
            <li class="credential-chip">{item}</li>
          ))}
        </ul>
      </div>

      <!-- Portrait -->
      <div class="flex justify-center lg:justify-end" data-reveal style="--reveal-delay: 120ms;">
        <div class="portrait-frame">
          <img
            src="/webp/Profile_Photo_Square.webp"
            alt="Nick Montelibano, medical device software consultant"
            width="320"
            height="320"
            loading="eager"
            decoding="async"
          />
          <div class="portrait-badge" aria-hidden="true">
            <span class="pulse-dot"></span>
            Accepting new engagements
          </div>
        </div>
      </div>
    </div>

    <!-- ECG divider -->
    <div class="ecg-wrap mt-16 md:mt-20" aria-hidden="true">
      <svg viewBox="0 0 900 60" preserveAspectRatio="none" class="ecg-svg">
        <path
          class="ecg-path"
          d="M0,30 H80 L92,24 L102,30 H130 L138,36 L148,4 L158,54 L166,30 H210 L224,20 L238,30 H300
             H380 L392,24 L402,30 H430 L438,36 L448,4 L458,54 L466,30 H510 L524,20 L538,30 H600
             H680 L692,24 L702,30 H730 L738,36 L748,4 L758,54 L766,30 H810 L824,20 L838,30 H900"
          fill="none"
          stroke="url(#ecg-gradient)"
          stroke-width="1.75"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <defs>
          <linearGradient id="ecg-gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#2dd4bf" stop-opacity="0.15" />
            <stop offset="0.5" stop-color="#2dd4bf" />
            <stop offset="1" stop-color="#38bdf8" stop-opacity="0.15" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    <!-- Stats -->
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px stats-grid mt-4" data-reveal>
      {stats.map((stat) => (
        <div class="stat-cell">
          <dt class="sr-only">{stat.label}</dt>
          <dd class="flex flex-col gap-1.5">
            <span class="stat-value">{stat.value}</span>
            <span class="text-sm text-[var(--muted)] leading-snug">{stat.label}</span>
          </dd>
        </div>
      ))}
    </dl>

    <LogoWall />
  </div>
</section>

<style>
  .text-balance {
    text-wrap: balance;
  }

  .credential-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    list-style: none;
  }
  .credential-chip::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.8;
  }

  .portrait-frame {
    position: relative;
    border-radius: 1.5rem;
    padding: 6px;
    background: linear-gradient(
      160deg,
      rgba(45, 212, 191, 0.5),
      rgba(148, 163, 184, 0.12) 40%,
      rgba(56, 189, 248, 0.35)
    );
  }
  .portrait-frame img {
    display: block;
    width: clamp(220px, 26vw, 320px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1.2rem;
  }
  .portrait-frame::after {
    content: "";
    position: absolute;
    inset: -18%;
    z-index: -1;
    background: radial-gradient(
      circle at 60% 40%,
      rgba(45, 212, 191, 0.16),
      transparent 65%
    );
    filter: blur(10px);
  }

  .portrait-badge {
    position: absolute;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: rgba(7, 12, 16, 0.92);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 500;
    backdrop-filter: blur(8px);
  }

  .pulse-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }
  .pulse-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgba(52, 211, 153, 0.6);
    animation: pulse-ring 2s ease-out infinite;
  }
  @keyframes pulse-ring {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  /* ECG trace draws itself in a loop */
  .ecg-wrap {
    position: relative;
  }
  .ecg-svg {
    display: block;
    width: 100%;
    height: 44px;
    overflow: visible;
  }
  .ecg-path {
    stroke-dasharray: 2400;
    stroke-dashoffset: 2400;
    animation: ecg-draw 7s linear infinite;
    filter: drop-shadow(0 0 6px rgba(45, 212, 191, 0.35));
  }
  @keyframes ecg-draw {
    0% {
      stroke-dashoffset: 2400;
    }
    70% {
      stroke-dashoffset: 0;
    }
    88% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  .stats-grid {
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--line);
  }
  .stat-cell {
    background: var(--surface);
    padding: 1.5rem 1.6rem;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ecg-path {
      animation: none;
      stroke-dashoffset: 0;
    }
    .pulse-dot::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
