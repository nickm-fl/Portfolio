---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Home from "../components/home.astro";
import ExpertiseSection from "../components/ExpertiseSection.astro";
import ProcessSection from "../components/ProcessSection.astro";
import PlatformsSection from "../components/PlatformsSection.astro";
import Contact from "../components/contact.astro";
import Footer from "../components/footer.astro";

const pageTitle =
  "Nick Montelibano — Medical Device Software Consultant | Fractal Logic";
---

<Layout title={pageTitle}>
  <Nav />
  <main>
    <Home />
    <ExpertiseSection />
    <ProcessSection />
    <PlatformsSection />
    <Contact />
  </main>
  <Footer />
</Layout>
